# Production mobile builds should point to the deployed gateway.
VITE_AI_GATEWAY_URL=https://api.virtugene.com

# Only for local/staging builds. This value is bundled into the client and is
# not a secret. Production should use an account-issued short-lived token.
VITE_AI_GATEWAY_TOKEN=

# Server-side variables (do not put these in the client .env file)
# DEEPSEEK_API_KEY=sk-...
# VIRTUGENE_GATEWAY_TOKEN=replace-me
# GATEWAY_CORS_ORIGIN=https://app.example.com
# GATEWAY_RATE_LIMIT=20
# GATEWAY_DAILY_LIMIT=300
